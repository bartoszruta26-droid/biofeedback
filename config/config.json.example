{
  "serial": {
    "port": "/dev/ttyUSB0",
    "baud_rate": 115200,
    "timeout_ms": 1000,
    "retry_count": 3
  },
  "storage": {
    "patient_backend": "files",
    "mariadb": {
      "host": "127.0.0.1",
      "port": 3306,
      "database": "biofeedback",
      "username": "biofeedback_app",
      "password_env": "BIOFEEDBACK_MARIADB_PASSWORD",
      "tls": true,
      "connect_timeout_seconds": 5
    }
  },
  "data": {
    "base_path": "./data/patients",
    "backup_enabled": true,
    "backup_interval_hours": 24,
    "max_backups": 7
  },
  "deployment": {
    "profile": "development"
  },
  "encryption": {
    "enabled": false,
    "algorithm": "AES-256-GCM",
    "key_derivation": "SHA-256 key normalization (32+ byte external secret)"
  },
  "ui": {
    "theme": "default",
    "language": "pl",
    "font_size": 12,
    "graph_update_interval_ms": 100,
    "graph_samples_visible": 300
  },
  "sensor": {
    "type": "HX711",
    "sample_rate_hz": 80,
    "gain": 128,
    "calibration_enabled": false,
    "calibration_profile": "calibration/hx711.json",
    "zero_threshold": 0.5
  },
  "devices": {
    "pico": {
      "transport": "serial",
      "baud_rate": 115200,
      "uart_tx_pin": 0,
      "uart_rx_pin": 1,
      "protocol": "biofeedback-control",
      "protocol_version": 1
    },
    "arduino_nano": {
      "transport": "serial",
      "baud_rate": 115200,
      "hx711_data_pin": 2,
      "hx711_clock_pin": 3,
      "protocol": "hx711-frame-v1"
    }
  },
  "logging": {
    "level": "INFO",
    "file": "./logs/biofeedback.log",
    "max_size_mb": 10,
    "rotate_count": 5,
    "console_output": false,
    "diagnostics_enabled": false
  },
  "games": {
    "difficulty_default": "medium",
    "biofeedback_sensitivity": 1.0,
    "session_duration_minutes": 15
  },
  "medical": {
    "require_authentication": true,
    "audit_log_enabled": true,
    "data_retention_days": 2555,
    "export_format": "JSON"
  }
}
